# Copie para .env e ajuste. Nunca faça commit do .env.
ENVIRONMENT=development          # em "production" a SECRET_KEY é obrigatória (>= 32 caracteres)
SECRET_KEY=                      # gere com: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///./usuarios.db
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                  # vazio = senha aleatória impressa no console no primeiro start
TOKEN_EXPIRE_MINUTES=60
MAX_FAILED_ATTEMPTS=5
LOCK_MINUTES=15
LOG_LEVEL=INFO
LOG_JSON=true                    # false = logs em texto legível (bom para desenvolvimento)

# Usado apenas pelo docker-compose
POSTGRES_PASSWORD=troque-esta-senha
